# Iris — Git Ignore Policy
# Purpose: Prevent committing local data, logs, secrets, and agent artifacts.

# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
.env.*
!.env.example
!.env.e2e.example
*.pem
*.key
*.p12
*.pfx

# --- Node / Frontend / Next / Storybook ---
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
storybook-static/
.eslintcache
**/.eslintcache
next-env.d.ts

# --- Tests & Playwright ---
coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
.playwright/

# --- Version Control ---
.git/
**/.git/

# --- IDEs & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs & Temporaries ---
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.dump
*.sql.gz

# --- Database & Local Infra ---
/db/backups
*.original.md
*.tsbuildinfo

# --- Chave privada age do backup off-site (#86/#105) ---
# Nomes de exemplo usados pelo runbook de verify-offsite.sh — sem isto, uma
# chave privada salva na raiz com o nome do exemplo não é ignorada.
*.age
id.txt
identity*
chave-privada*
chave-iris*

# --- Scratch / throwaway ---
scratch/

# --- TWA / Bubblewrap (#185, Etapa 3) ---
# Chave privada de assinatura — NUNCA versionar. Quem tiver este arquivo mais a
# senha pode publicar uma atualização do app no lugar da gente.
twa/*.keystore
twa/*.jks
twa/android.keystore.passwords
# Artefatos de build e projeto Android gerado (reconstruíveis a partir do
# twa-manifest.json).
twa/app/
twa/build/
twa/.gradle/
twa/gradle/
twa/gradlew
twa/gradlew.bat
twa/*.aab
twa/*.apk
twa/*.idsig
twa/store_icon.png

# --- Lighthouse (#185) ---
# Artefatos de medição local, regeráveis a qualquer momento — o número que
# importa vai para docs/arquitetura/pwa-e-cache.md, não o relatório em si.
lighthouse-mobile.report.json
lighthouse-mobile.report.html

# --- Agentic Noise & Tooling ---
.claude/
.superpowers/
.tokensave/
.headroom/
.playwright-mcp/
.worktrees/
graphify-out/
skills-lock.json
.vercel/

# design-sync
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/
.design-sync/dts/

# Config local de MCP (pode conter token de servidor) — nunca versionar
.mcp.json
