{
  "name": "iris",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "publishConfig": {
    "types": ".design-sync/dts/design-system.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.integration.config.ts",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "seed": "tsx --conditions=react-server --env-file=.env scripts/seed.ts",
    "seed:local": "tsx --conditions=react-server --env-file=.env scripts/seed-local.ts",
    "seed:clinic": "tsx --conditions=react-server --env-file=.env scripts/seed-local.ts",
    "seed:demo": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-demo.ts",
    "seed:e2e": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-e2e.ts",
    "seed:superadmin": "tsx --conditions=react-server --env-file=.env scripts/seed-super-admin.ts",
    "seed:custom": "tsx --conditions=react-server --env-file=.env scripts/seed-demo-account.ts",
    "unlock:user": "tsx --conditions=react-server --env-file=.env scripts/unlock-user.ts",
    "backfill:evidence": "tsx --conditions=react-server --env-file=.env scripts/backfill-evidence.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@microsoft/clarity": "^1.0.2",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@sentry/nextjs": "^10.67.0",
    "better-auth": "1.6.23",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "next": "16.2.11",
    "pdfkit": "^0.19.1",
    "playwright": "^1.61.1",
    "postgres": "^3.4.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "svix": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@google/genai": "^2.17.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-vitest": "10.5.3",
    "@storybook/nextjs-vite": "10.5.3",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.10.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-storybook": "10.5.3",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "otpauth": "^9.5.1",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "storybook": "10.5.3",
    "tailwindcss": "4.3.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "4.1.10"
  }
}
