{
  "projectId": "1009e8cc-2741-41f7-b76a-a57e96e84aa9",
  "shape": "storybook",
  "pkg": "iris",
  "globalName": "IrisDS",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "entry": "src/design-system.ts",
  "buildCmd": "npx tsc -p .design-sync/tsconfig.dts.json",
  "readmeHeader": ".design-sync/conventions.md",
  "extraEntries": [
    "./.design-sync/preview-provider.tsx"
  ],
  "provider": {
    "component": "IrisPreviewProvider",
    "props": {
      "modo": "clinico",
      "tema": "claro"
    }
  },
  "titleMap": {
    "Toast": "ToastProvider",
    "Layout": "Container",
    "Welcome": null,
    "Colors": null,
    "Icons": null,
    "Spacing&Borders": null,
    "Typography": null,
    "Overview": null,
    "Agenda": null,
    "Pendências": null,
    "Supervisão": null,
    "Validação": null
  },
  "extraFonts": [
    ".design-sync/ds-fonts.css"
  ],
  "overrides": {
    "Container": {
      "cardMode": "column"
    },
    "EvidenceTimeline": {
      "cardMode": "column"
    },
    "InteractiveCard": {
      "cardMode": "column"
    },
    "Header": {
      "cardMode": "column"
    }
  }
}
