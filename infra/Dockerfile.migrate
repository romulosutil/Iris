# Dockerfile dedicado ao JOB de migração (gate de schema no deploy).
# Existe separado do infra/Dockerfile porque o Easypanel (build Dockerfile)
# não expõe --target: ele builda sempre o ÚLTIMO stage. Aqui o último stage
# É o migrate, então o serviço `iris-migrate` roda `node scripts/migrate.mjs`
# e sai — sem subir servidor. Mesma lógica do stage `migrate` do Dockerfile
# principal (ver infra/README.md §"Gate de schema no deploy").
#
# Build context = raiz do repo; Dockerfile path = infra/Dockerfile.migrate.
# Env obrigatória do serviço: MIGRATION_DATABASE_URL (role dona/DDL).
# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app
# `corepack enable` só instala os shims; o binário do pnpm baixa do npm
# registry na 1ª invocação por stage. `corepack install` materializa a
# versão de `packageManager` aqui, num layer cacheado por `deps`/`migrate`,
# tirando o registry do caminho crítico do build.
COPY package.json ./
RUN corepack install

# deps: node_modules de produção (drizzle-orm + postgres são deps de prod).
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# `patchedDependencies` (pnpm-workspace.yaml) referencia arquivos em patches/.
# Sem eles no contexto, `pnpm install` morre com
# `ENOENT: ... open '/app/patches/module-alias@2.3.4.patch'` — medido.
COPY patches ./patches
RUN pnpm install --frozen-lockfile

# migrate: ÚLTIMO stage = job. Aplica db/migrations e sai != 0 se falhar,
# abortando o deploy (o app velho segue no ar contra o schema velho).
#
# Também carrega scripts/seed-clinic.ts (+ src/ + tsconfig, needed pelos
# imports @/): mesma imagem serve pra provisionar clínica+coordenador via
# `pnpm exec tsx --conditions=react-server scripts/seed-clinic.ts ...`
# rodado manualmente no console do Easypanel (Comando sobrescrito).
#
# ⚠️ Desde o fechamento da Fatia A (#163), o serviço `iris-migrate` NÃO carrega
# mais `AUTH_DATABASE_URL`, `BETTER_AUTH_SECRET` nem `BETTER_AUTH_URL`: um job
# que só faz DDL não tem por que guardar a chave de assinatura de sessão. O
# `scripts/migrate.mjs` lê apenas `MIGRATION_DATABASE_URL` (fallback
# `DATABASE_URL` em dev), então o gate de schema segue intacto.
# Consequência: o caminho manual do seed-clinic passou a exigir injeção
# ad-hoc de `AUTH_DATABASE_URL` na execução. O caminho normal de entrada de
# usuário novo é o cadastro self-service em /cadastro, não o seed.
FROM base AS migrate
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY scripts ./scripts
COPY db/migrations ./db/migrations
COPY src ./src
CMD ["node", "scripts/migrate.mjs"]
